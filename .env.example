# Environment configuration for CertificateGuard
DATABASE_URL=sqlite+aiosqlite:///./certificateguard.db
# PostgreSQL alternative for production / docker:
# DATABASE_URL=postgresql+asyncpg://certguard:certguard_secret@localhost:5432/certificateguard

SECRET_KEY=dev_secret_key_certificate_guard_super_secure_32_bytes_min_12345
ENVIRONMENT=development
PORT=8000
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=15
MAX_PDF_PAGES=10
PLAYWRIGHT_TIMEOUT_MS=15000
MOCK_ISSUER_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
